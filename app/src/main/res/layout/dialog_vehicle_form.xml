<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FAFAFA"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header con icono -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:paddingVertical="16dp"
            android:background="@drawable/bg_dialog_header">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_car"
                android:tint="#1A237E"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Agregar Vehículo"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#1A237E"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Completa la información de tu vehículo"
                android:textSize="14sp"
                android:textColor="#666666"
                android:gravity="center"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Campos del formulario -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Placa -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:startIconDrawable="@drawable/ic_license_plate"
                    app:startIconTint="#1A237E"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="#1A237E"
                    app:hintTextColor="#1A237E">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etLicensePlate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Placa del vehículo"
                        android:textSize="16sp"
                        android:maxLines="1"
                        android:textColor="#333333" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Repite para los otros campos sin el style="@style/ModernTextInputLayout" -->
                <!-- Marca -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:startIconDrawable="@drawable/ic_brand"
                    app:startIconTint="#1A237E"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="#1A237E"
                    app:hintTextColor="#1A237E">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBrand"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Marca"
                        android:textSize="16sp"
                        android:maxLines="1"
                        android:textColor="#333333" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Modelo -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:startIconDrawable="@drawable/ic_model"
                    app:startIconTint="#1A237E"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="#1A237E"
                    app:hintTextColor="#1A237E">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etModel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Modelo"
                        android:textSize="16sp"
                        android:maxLines="1"
                        android:textColor="#333333" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Color -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:startIconDrawable="@drawable/ic_color"
                    app:startIconTint="#1A237E"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="#1A237E"
                    app:hintTextColor="#1A237E">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etColor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Color"
                        android:textSize="16sp"
                        android:maxLines="1"
                        android:textColor="#333333" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Año -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:startIconDrawable="@drawable/ic_year"
                    app:startIconTint="#1A237E"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="#1A237E"
                    app:hintTextColor="#1A237E">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etYear"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Año"
                        android:textSize="16sp"
                        android:maxLines="1"
                        android:inputType="number"
                        android:textColor="#333333" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- El resto del layout se mantiene igual -->
        <!-- Checkbox Vehículo Principal -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#F8F9FF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_star"
                    android:tint="#1A237E"
                    android:layout_marginEnd="12dp" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbDefault"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Establecer como vehículo principal"
                    android:textSize="14sp"
                    android:textColor="#1A237E"
                    app:buttonTint="#1A237E" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Botones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Cancelar"
                android:textSize="16sp"
                android:textColor="#1A237E"
                android:backgroundTint="#E8EAF6"
                app:cornerRadius="12dp"
                android:layout_marginEnd="6dp"
                android:textStyle="bold"
                app:icon="@drawable/ic_close"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Guardar"
                android:textSize="16sp"
                android:backgroundTint="#1A237E"
                android:textColor="#FFFFFF"
                app:cornerRadius="12dp"
                android:layout_marginStart="6dp"
                android:textStyle="bold"
                app:icon="@drawable/ic_save"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="#FFFFFF" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>