<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    tools:context=".ui.scanner.ScannerFragment">

    <!-- 🔹 Cámara -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- 🔹 Overlay suave (más claro) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#40FFFFFF" />

    <!-- 🔹 Marco de escaneo -->
    <LinearLayout
        android:id="@+id/centerContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <View
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:background="@drawable/scanner_frame_light" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Escanea el código QR del boleto"
            android:textColor="#1A237E"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:text="Coloca el QR dentro del recuadro para continuar."
            android:textColor="#455A64"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp" />

        <!-- 🔹 Aquí VA EL txtStatus, no en el header -->
        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#1A237E"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="18dp" />

    </LinearLayout>

    <!-- 🔹 Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center_vertical">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnBack"
            android:layout_width="46dp"
            android:layout_height="46dp"
            app:cardCornerRadius="23dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#FFFFFF"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="←"
                android:textColor="#1A237E"
                android:textSize="20sp"
                android:gravity="center" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Escanear Boleto"
            android:textColor="#1A237E"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginStart="16dp" />

    </LinearLayout>

    <!-- 🔹 Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:padding="26dp"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿Problemas al escanear?"
                    android:textColor="#546E7A"
                    android:textSize="14sp"
                    android:layout_marginBottom="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEnterTicket"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ingresar ticket manualmente"
                    android:textColor="#1A237E"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    app:cornerRadius="16dp"
                    app:backgroundTint="#E3F2FD"
                    android:paddingVertical="14dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</FrameLayout>
